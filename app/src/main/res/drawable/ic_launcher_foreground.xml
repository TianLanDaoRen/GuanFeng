<?xml version="1.0" encoding="utf-8"?>
<!--
  观风 · 主图标前景：剪纸风祥云 + 风纹。

  构图（108 视口，主体收在 22–86 的圆形安全区内）：
    · 墨黑祥云：三个圆叠一个圆角底边，取剪纸的实心感
    · 朱砂点睛：云心一枚朱砂圆点，落款的意
    · 风纹两笔：自左向右掠过云下，上一笔右端上卷——"观风"的字面意思
  只用三色：宣纸米白底、墨黑主体、朱砂一点。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 祥云：左侧小圆 -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M32.5,46 a11.5,11.5 0 1,0 23,0 a11.5,11.5 0 1,0 -23,0 z" />
    <!-- 祥云：中央大圆 -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M47.5,42 a14.5,14.5 0 1,0 29,0 a14.5,14.5 0 1,0 -29,0 z" />
    <!-- 祥云：右侧小圆 -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M67,50 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 z" />
    <!-- 祥云：圆角底边，把三个圆连成一片云 -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M29,56 a6,6 0 0 1 6,-6 h44 a6,6 0 0 1 6,6 v0 a6,6 0 0 1 -6,6 h-44 a6,6 0 0 1 -6,-6 z" />

    <!-- 朱砂点睛 -->
    <path
        android:fillColor="#C0442E"
        android:pathData="M50.5,53 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 z" />

    <!-- 风纹上一笔：右端上卷 -->
    <path
        android:pathData="M22,70 H54 C60,70 62.5,66 62.5,61.5"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <!-- 风纹下一笔 -->
    <path
        android:pathData="M22,79 H44"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
</vector>
