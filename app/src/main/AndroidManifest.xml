<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OPPO 硬约束：手表应用必须在 Manifest 声明 watch feature -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- 心率 / PPG 等体征传感器需要运行时授权 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- 计步与步态检测 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 前台保活：官方口径「不支持后台运行」，重要记录须走前台服务 -->
    <!--
      直接驱动马达。为什么不用通知来震动：手表 SystemUI 的 canPost 白名单
      把第三方本地通知全部拦掉（实测连提醒流程都不走、点了毫无震动），
      所以只能自己调。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Android 13+ 才需要运行时申请；API 30 设备上为无害声明 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      联网仅用于「AI 报告」这一项可选功能（用户显式点按钮并在弹窗确认后才会发起）。
      核心功能——气压趋势、高度解耦、打卡、关联视图——全部离线，不依赖此权限。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuanFeng">

        <!-- singleTask：官方要求，防 Monkey 验收堆出多个 MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GuanFeng"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 记录用前台服务：挂 indicator，防止熄屏后被系统回收导致记录断档 -->
        <service
            android:name=".service.WatchSessionService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>

</manifest>
