<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OPPO 硬约束：手表应用必须在 Manifest 声明 watch feature -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- 心率 / PPG 等体征传感器需要运行时授权 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- 计步与步态检测 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 前台保活：官方口径「不支持后台运行」，重要记录须走前台服务 -->
    <!--
      直接驱动马达。为什么不用通知来震动：手表 SystemUI 的 canPost 白名单
      把第三方本地通知全部拦掉（实测连提醒流程都不走、点了毫无震动），
      所以只能自己调。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      开机自启：**只用于「真正的系统重启」这一种情形**。
      睡眠模式那种"停掉一切应用"等价于 force-stop，广播与 START_STICKY 都拉不回来，
      只能靠用户手动点开一次——那条路本来就无解，见 BootReceiver 的注释。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Android 13+ 才需要运行时申请；API 30 设备上为无害声明 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      联网仅用于「AI 报告」这一项可选功能（用户显式点按钮并在弹窗确认后才会发起）。
      核心功能——气压趋势、高度解耦、打卡、关联视图——全部离线，不依赖此权限。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      天气采集的定位权限。

      **FINE 是必须的，这不是贪心**：GPS_PROVIDER 只认 ACCESS_FINE_LOCATION，
      只有 COARSE 时 requestLocationUpdates(gps, ...) 会直接抛 SecurityException。
      第一版我为了"少弹一次授权"只申请了 COARSE，结果 GPS 根本调不起来——
      而异常又被 runCatching 吞掉，日志写成"超时（室内常见）"，
      把一个权限问题误诊成了信号问题。主人一眼看穿：没申请权限，调用个什么 GPS。

      COARSE 一并保留：Wi-Fi/网络定位只需要它，是混合定位里更快的那条路。
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuanFeng">

        <!-- singleTask：官方要求，防 Monkey 验收堆出多个 MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GuanFeng"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 记录用前台服务：挂 indicator，防止熄屏后被系统回收导致记录断档 -->
        <service
            android:name=".service.WatchSessionService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!--
          系统重启后把采集拉起来。此前应用里**没有任何入口**会启动这个服务
          （只有 MainActivity.onCreate 会调），所以重启一次就断到用户想起来点开为止。
          exported 必须为 true 才收得到 BOOT_COMPLETED 这类受保护广播（Android 12+ 的硬要求）。
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
